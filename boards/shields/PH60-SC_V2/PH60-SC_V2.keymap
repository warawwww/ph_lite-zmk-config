#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/hid_indicators.h>

#define LAYER_Lock 0
#define LAYER_Base 1
#define LAYER_Function 2
#define LAYER_Bluetooth 3
#define LAYER_RGB 4

#include "PH60-SC_V2-rgb.dtsi"



/ {

    combos {
        compatible = "zmk,combos";

                // fn(59) + B(46) + Enter(40) on LAYER_Lock -> unlock
        combo_unlock {
            timeout-ms = <100>;
            key-positions = <59 46 40>;
            bindings = <&unlock_macro>;
            layers = <LAYER_Lock>;
        };
    };

    behaviors {
        
        // Macro to clear current BT profile (tap)
        bt_clear_current_macro: bt_clear_current_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        // Macro to clear all BT profiles (hold)
        bt_clear_all_macro: bt_clear_all_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
        };

                                                                                // Soft off macro: power off (wake restarts from layer 0 = Lock)
        soft_off_macro: soft_off_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&soft_off>;
        };

                // Unlock macro: switch to base layer -> RGB on
        unlock_macro: unlock_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to LAYER_Base>, <&rgb_ug RGB_ON>;
        };

        // Hold to clear all BT profiles, Tap to clear current
        bt_clear_holdtap: bt_clear_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_clear_all_macro>, <&bt_clear_current_macro>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

                        lock_layer {
            display-name = "Lock";
            bindings = <
&none    &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none    &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none    &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none          &trans
&none           &none  &none  &none  &none  &trans &none  &none  &none  &none  &none          &none
&none    &none  &none                      &none                      &none  &none  &trans  &none
            >;
        };

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9  &kp N0    &kp MINUS &kp EQUAL     &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O   &kp P     &kp LBKT  &kp RBKT      &kp BSLH
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L   &kp SEMI  &kp SQT                 &kp RET
&kp LSHFT        &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M     &kp COMMA &kp DOT &kp SLASH               &mt RSHFT UP
&kp LCTRL &kp LGUI &kp LALT                 &kp SPACE                &kp RALT  &mt RGUI DOWN  &lt LAYER_Function LEFT  &mt RCTRL RIGHT
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&kp GRAVE &kp F1    &kp F2    &kp F3          &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12       &kp DEL
&trans    &trans    &kp UP    &trans          &sys_reset  &trans  &trans    &trans    &trans    &trans    &kp PSCRN &kp HOME  &kp END       &studio_unlock
&trans    &kp LEFT  &kp DOWN  &kp RIGHT       &trans      &trans  &trans    &trans    &trans    &trans    &kp PG_UP &kp PG_DN               &trans
&trans              &rgb_ug RGB_TOG &mo LAYER_RGB   &trans          &trans          &mo LAYER_Bluetooth &trans &trans &trans &trans &trans     &trans
&trans    &trans    &trans                              &trans                                  &trans    &trans    &trans                  &trans
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &soft_off_macro
&out OUT_TOG &trans        &trans        &trans        &bootloader   &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans          &bt_clear_holdtap 0 0
&trans                     &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans       &trans        &trans                                    &trans                        &trans  &trans  &trans                  &trans
            >;
        };

        rgb_layer {
            display-name = "RGB";
            bindings = <
&trans       &trans        &trans        &trans        &trans        &trans        &trans               &trans             &trans             &trans             &trans             &trans              &trans            &trans 
&trans       &trans        &trans        &trans        &trans        &trans        &trans               &rgb_ug RGB_HUD    &rgb_ug RGB_HUI    &rgb_ug RGB_SAD    &rgb_ug RGB_SAI    &rgb_ug RGB_EFR     &rgb_ug RGB_EFF   &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans               &rgb_ug RGB_BRD    &rgb_ug RGB_BRI    &rgb_ug RGB_SPD    &rgb_ug RGB_SPI    &trans                                &trans
&trans                     &trans        &trans        &trans        &trans        &trans               &trans             &trans             &trans             &trans             &trans                                &trans
&trans       &trans        &trans                                     &trans                                      &trans             &trans             &trans                                &trans
            >;
        };

        extra1 {
            display-name = "Extra 1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra 2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra 3";
            status = "reserved";
        };
    };
};


